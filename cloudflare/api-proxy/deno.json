{
  "imports": {
    "@std/assert": "jsr:@std/assert@1.0.13"
  },
  "compilerOptions": {
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "fmt": {
    "lineWidth": 120
  },
  "tasks": {
    "verify": "deno fmt --check && deno lint && deno check src/proxy.ts && deno test src/"
  }
}
