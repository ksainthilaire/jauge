{
  "imports": {
    "@electric-sql/pglite": "npm:@electric-sql/pglite@0.3.14",
    "@std/assert": "jsr:@std/assert@1.0.13",
    "@std/yaml": "jsr:@std/yaml@1.0.9",
    "jose": "npm:jose@6.2.12",
    "postgres": "npm:postgres@3.4.9"
  },
  "compilerOptions": {
    "strict": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "fmt": {
    "lineWidth": 120,
    "indentWidth": 2,
    "exclude": [
      "coverage/"
    ]
  },
  "lint": {
    "rules": {
      "tags": [
        "recommended"
      ],
      "include": [
        "eqeqeq",
        "no-console",
        "explicit-module-boundary-types"
      ]
    },
    "exclude": [
      "coverage/"
    ]
  },
  "tasks": {
    "check": "deno check index.ts src/**/*.ts",
    "test": "deno test --allow-read --allow-env --allow-net=registry.npmjs.org,jsr.io src/",
    "verify": "deno fmt --check && deno lint && deno task check && deno task test"
  }
}
