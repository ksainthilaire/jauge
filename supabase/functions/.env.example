# Secrets of the Edge Functions. Copy to supabase/functions/.env for local tests (ignored by git), or set them on the
# hosted project with: supabase secrets set --env-file supabase/functions/.env
# NEVER commit real values.
JAUGE_WEBHOOK_SECRET=
FCM_SERVICE_ACCOUNT_JSON=
APNS_KEY_P8=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=io.jauge.app
APNS_USE_SANDBOX=true

# Edge Function "api" (docs/backend/DEPLOIEMENT.md). SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY and SUPABASE_DB_URL are
# provided by Supabase. JAUGE_WEBHOOK_SECRET above is shared with the database (Vault secret jauge_webhook_secret).
JAUGE_ENVIRONMENT=production
JAUGE_PROVIDER_MODE=simulated
JAUGE_DAILY_SPEND_LIMIT_USD=3
JAUGE_SPEND_WARNING_RATIO=0.8
JAUGE_FREE_ANALYSES_PER_WEEK=1
JAUGE_PLUS_ANALYSES_PER_DAY=30
JAUGE_CACHE_DAYS=7
JAUGE_ANALYSIS_DEADLINE_SECONDS=75
JAUGE_MAINTENANCE=false
JAUGE_INLINE_WORKER=false
JAUGE_IP_HASH_SALT=
JAUGE_PROXY_SECRET=
JAUGE_ALERT_WEBHOOK_URL=
SUPABASE_JWT_SECRET=
REVENUECAT_WEBHOOK_AUTHORIZATION=
REVENUECAT_SECRET_API_KEY=
APPLE_TEAM_ID=
APPLE_CLIENT_ID=io.jauge.app
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_P8=
# AI and social search (docs/backend/ia.md). Used when JAUGE_PROVIDER_MODE=live.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-2603
JAUGE_SOCIAL_SOURCES=reddit,x
JAUGE_REPUTATION_CACHE_DAYS=30
# Apify: sources of offers (docs/backend/sources.md) and social search, used when JAUGE_PROVIDER_MODE=live. Without
# APIFY_TOKEN: no market collection. Webhook: direct Supabase URL (the Cloudflare proxy drops its header).
APIFY_TOKEN=
APIFY_PRICING_TIER=BRONZE
JAUGE_APIFY_SOURCES=linkedin,hellowork
JAUGE_APIFY_COMPLEMENTARY_SOURCES=indeed
JAUGE_APIFY_OFFERS_PER_SOURCE=60
APIFY_WEBHOOK_URL=https://ynvaaswsenerrummanrs.supabase.co/functions/v1/api/webhooks/apify
APIFY_WEBHOOK_SECRET=
JAUGE_PAGE_USER_AGENT=
