# Secrets of the Edge Functions. Copy to supabase/functions/.env for local tests (ignored by git), or set them on the
# hosted project with: supabase secrets set --env-file supabase/functions/.env
# NEVER commit real values.
JAUGE_WEBHOOK_SECRET=
FCM_SERVICE_ACCOUNT_JSON=
APNS_KEY_P8=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=io.jauge.app
APNS_USE_SANDBOX=true
