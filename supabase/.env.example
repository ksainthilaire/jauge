# Settings read by the Supabase CLI for supabase/config.toml (env(...)). Copy to supabase/.env (ignored by git) and fill
# it. NEVER commit real values. Used by `supabase start` (local) and `supabase config push` (hosted project).
# Brevo SMTP relay (Brevo > SMTP & API > SMTP): the SMTP login and an SMTP key (not the API key).
BREVO_SMTP_LOGIN=
BREVO_SMTP_KEY=
# Sign in with Apple and Google (docs/supabase.md, section 3).
SUPABASE_AUTH_EXTERNAL_APPLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_APPLE_SECRET=
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
