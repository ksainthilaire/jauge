<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Approximate position only (city level), turned into a city on the phone. Never the precise position. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- The app works without location: the default city (Paris) is used. -->
    <uses-feature android:name="android.hardware.location" android:required="false" />
    <uses-feature android:name="android.hardware.location.network" android:required="false" />

    <application>
        <activity
            android:name="io.jauge.core.location.LocationPermissionActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:screenOrientation="behind"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
    </application>
</manifest>
